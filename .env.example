# Chatbot Lambda environment variables (copy to .env, fill values)

# AWS region for Bedrock
AWS_REGION=ap-northeast-2

# AWS credentials (or use IAM role / ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Bedrock model ID (Phase 4 사전 조사에서 확정, 2026-05-29 Sonnet 4.6으로 갈아끼움 — Sonnet 4 APAC이 Legacy 마킹 받음)
# - 챗봇 Lambda(gb-chatbot-lambda) 기본값: Sonnet 4.6.
# - 번역 Lambda(gb-community-translator) 는 비용·속도 우선이라 별도 Lambda 환경변수로
#   Haiku inference profile (예: global.anthropic.claude-haiku-4-5) 을 주입한다.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# MCP server URLs
# 한 Lambda가 전 환경 공유 — 페이로드 environment(dev/stage/prod)로 라우팅(ai-chatbot-mcp.md §9).
# 우선순위: 환경별(_STAGE/_PROD) → 공용 → 기본값(localhost, 로컬 테스트).
MCP_EXCHANGE_URL=http://localhost:8000/mcp
MCP_COMMUNITY_URL=http://localhost:8001/mcp
# stage: 계정 B 내부 NLB DNS (Lambda VPC ↔ stage EKS VPC 피어링 경유)
# MCP_EXCHANGE_URL_STAGE=http://<internal-nlb-dns>:8000/mcp
# MCP_COMMUNITY_URL_STAGE=http://<internal-nlb-dns>:8000/mcp
# prod: 계정 A MCP를 PrivateLink로 당겨오는 Interface Endpoint DNS
# MCP_EXCHANGE_URL_PROD=http://<vpce-dns>:8000/mcp
# MCP_COMMUNITY_URL_PROD=http://<vpce-dns>:8000/mcp

# Bedrock Knowledge Base ID (3단계, 유진한테 받음)
# LEGAL_KB_ID=

# Tavily Remote MCP Server (외부 회사 직접 연결, 시나리오 ⑤ 웹 검색용)
# - 키 발급: https://app.tavily.com/home (Researcher Plan 월 1,000 search 무료)
# - URL은 코드에 상수로 박혀있어 별도 지정 불필요 (선택적으로 TAVILY_MCP_URL로 override)
TAVILY_API_KEY=
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# ─────────────────────────────────────────────────────────────────────────────
# 번역 Lambda (gb-community-translator) 전용 변수
# ─────────────────────────────────────────────────────────────────────────────
# AWS_REGION 은 챗봇과 공유. BEDROCK_MODEL_ID 는 Lambda 환경변수로 따로 주입(Haiku).
# 예: BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5
#     또는 apac.anthropic.claude-haiku-4-5
# 로컬 테스트 (tests/local_translator_run.py) 시에만 셸 환경변수로 export.
